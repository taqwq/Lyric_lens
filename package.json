{
  "name": "lyric-lens",
  "version": "3.0.0",
  "private": true,
  "description": "Genius の歌詞を、曲全体の文脈を踏まえた自然な日本語訳と必要な注釈で読み解く userscript",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "live": "node scripts/run.mjs scripts/live-test.ts"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
